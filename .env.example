# ── Base de datos (Supabase → Project Settings → Database → Connection string) ──
# Pooler (Transaction mode, puerto 6543) para la app:
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexión directa (puerto 5432) para migraciones de Prisma:
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ── Autenticación del dashboard ──
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Admin inicial creado por `npm run db:seed`
SEED_ADMIN_EMAIL="admin@fidofelix.mx"
SEED_ADMIN_PASSWORD="FidoFelix2026!"

# ── IA (Claude) ──
ANTHROPIC_API_KEY="sk-ant-..."
# Opcional: modelo a usar (por defecto claude-opus-5-5)
# AI_MODEL="claude-opus-5-5"

# ── WhatsApp Cloud API (Meta for Developers → WhatsApp → API Setup) ──
WHATSAPP_TOKEN="EAAG..."
WHATSAPP_PHONE_NUMBER_ID="123456789012345"
# Token que tú inventas y pegas en Meta al configurar el webhook:
WHATSAPP_VERIFY_TOKEN="fidofelix-verify-token"
# App Secret (App Settings → Basic) para validar la firma de los webhooks:
WHATSAPP_APP_SECRET="..."
WHATSAPP_API_VERSION="v23.0"

# ── Negocio ──
# Número público para el botón de WhatsApp de la web (formato internacional sin +)
NEXT_PUBLIC_WHATSAPP_NUMBER="51987654321"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
