// Fido&Felix — esquema de base de datos (PostgreSQL en Supabase)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
}

enum Species {
  DOG
  CAT
  OTHER
}

enum PetSize {
  SMALL
  MEDIUM
  LARGE
  XLARGE
}

enum ServiceCategory {
  GROOMING
  HEALTH
  TRAINING
  DAYCARE
  WALKING
  SPA
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BookingSource {
  WHATSAPP
  WEB
  DASHBOARD
  PHONE
}

enum MessageRole {
  USER
  ASSISTANT
  STAFF
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(STAFF)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  bookings Booking[] @relation("AssignedBookings")
}

model Client {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  email     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pets         Pet[]
  bookings     Booking[]
  conversation Conversation?
}

model Pet {
  id        String   @id @default(cuid())
  name      String
  species   Species  @default(DOG)
  breed     String?
  size      PetSize?
  notes     String?
  clientId  String
  createdAt DateTime @default(now())

  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@unique([clientId, name])
}

model Service {
  id          String          @id @default(cuid())
  slug        String          @unique
  name        String
  description String
  category    ServiceCategory
  durationMin Int
  price       Int // precio en pesos MXN
  active      Boolean         @default(true)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  bookings Booking[]
}

model Booking {
  id           String        @id @default(cuid())
  code         String        @unique
  startsAt     DateTime
  endsAt       DateTime
  status       BookingStatus @default(PENDING)
  source       BookingSource @default(WEB)
  price        Int
  notes        String?
  clientId     String
  petId        String?
  serviceId    String
  assignedToId String?
  cancelledAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  client     Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  pet        Pet?    @relation(fields: [petId], references: [id], onDelete: SetNull)
  service    Service @relation(fields: [serviceId], references: [id])
  assignedTo User?   @relation("AssignedBookings", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([startsAt])
  @@index([status])
}

model Conversation {
  id            String   @id @default(cuid())
  phone         String   @unique
  profileName   String?
  aiEnabled     Boolean  @default(true)
  unread        Int      @default(0)
  lastMessageAt DateTime @default(now())
  clientId      String?  @unique
  createdAt     DateTime @default(now())

  client   Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([lastMessageAt])
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String
  waMessageId    String?     @unique
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
